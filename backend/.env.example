# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql+asyncpg://user:pass@host.neon.tech/neondb?ssl=require

# --- Firebase ---
# Either path to credentials file, or FIREBASE_CREDENTIALS_JSON with the full
# service-account JSON as a single line (preferred on Render/Vercel).
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# FIREBASE_CREDENTIALS_JSON={...}

# --- Groq AI ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Storage ---
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --- Redis (only needed for Celery jobs; leave default if unused) ---
REDIS_URL=redis://localhost:6379/0

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
